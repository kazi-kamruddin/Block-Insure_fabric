# Pinned local-development versions
FABRIC_VERSION=2.5.16
FABRIC_CA_VERSION=1.5.17

# Shared channel and future Go chaincode definition
CHANNEL_NAME=insurance-channel
CHAINCODE_NAME=insurance-contract
CHAINCODE_LANGUAGE=golang
CHAINCODE_VERSION=1.0.0
# Leave blank to auto-resolve: 1 on a clean channel or the next sequence on reuse.
CHAINCODE_SEQUENCE=

# Development network behavior
STATE_DATABASE=couchdb
TLS_ENABLED=true
