# The path may be absolute or relative to apps/web.
FABRIC_NETWORK_ROOT=../../network
FABRIC_CHANNEL_NAME=insurance-channel
FABRIC_CHAINCODE_NAME=insurance-contract
FABRIC_EVALUATE_DEADLINE_SECONDS=5
FABRIC_ENDORSE_DEADLINE_SECONDS=15
FABRIC_SUBMIT_DEADLINE_SECONDS=5
FABRIC_COMMIT_STATUS_DEADLINE_SECONDS=60

# Local demonstration authentication. Generate a random value of at least 32
# characters for AUTH_SECRET. Never commit a real value.
ENABLE_DEMO_AUTH=true
AUTH_SECRET=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false

# Ciphertext-only local evidence storage. Encryption keys are never stored here.
EVIDENCE_STORAGE_ROOT=../../data/evidence
EVIDENCE_MAX_UPLOAD_BYTES=10485760
