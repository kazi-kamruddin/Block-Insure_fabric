# The path may be absolute or relative to apps/web.
FABRIC_NETWORK_ROOT=../../network
FABRIC_CHANNEL_NAME=insurance-channel
FABRIC_CHAINCODE_NAME=insurance-contract
FABRIC_EVALUATE_DEADLINE_SECONDS=5
FABRIC_ENDORSE_DEADLINE_SECONDS=15
FABRIC_SUBMIT_DEADLINE_SECONDS=5
FABRIC_COMMIT_STATUS_DEADLINE_SECONDS=60
FABRIC_EVENT_SYNC_DEADLINE_SECONDS=10

# Local demonstration authentication. Generate a random value of at least 32
# characters for AUTH_SECRET. Never commit a real value.
ENABLE_DEMO_AUTH=true
AUTH_SECRET=
SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=false
APP_ORIGIN=http://localhost:3000

# Manual premium OTPs are one-time, policy/mandate-bound, expire after five
# minutes, and lock after five failures. In demo mode the UI displays the code;
# production must deliver it through an external bank/SMS adapter.
OTP_SECRET=
OTP_TTL_SECONDS=300

# Long random bearer token used only by the durable premium collection adapter.
BANKING_WORKER_SECRET=

# Optional bearer token for an external scheduler calling the idempotent Fabric
# event synchronization route. Insurer demo sessions can also trigger it.
EVENT_WORKER_SECRET=
EVENT_PROJECTION_ROOT=../../data/events
FABRIC_EVENT_START_BLOCK=0

# Ciphertext-only local evidence storage. Encryption keys are never stored here.
EVIDENCE_STORAGE_ROOT=../../data/evidence
EVIDENCE_MAX_UPLOAD_BYTES=10485760
